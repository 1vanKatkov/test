[Unit]
Description=Astrolhub miniapp (FastAPI + Telegram bot)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/opt/test/test
EnvironmentFile=/root/opt/test/test/.env
ExecStart=/root/opt/test/test/.venv/bin/python run_all.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
